{
  "name": "aura-pipeline-service",
  "version": "1.0.0",
  "description": "Server-side pipeline for AURA Stylist - daily outfit pre-computation for popular cities",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "pipeline:daily": "node dist/pipeline/orchestrator.js",
    "pipeline:weather": "PIPELINE_MODE=weather-only node dist/pipeline/orchestrator.js",
    "pipeline:manual": "tsx src/scripts/run-pipeline.ts",
    "seed:cities": "tsx src/scripts/seed-cities.ts",
    "test": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t aura-pipeline-service .",
    "docker:run": "docker-compose up"
  },
  "keywords": [
    "fashion",
    "styling",
    "ai",
    "pipeline",
    "gcp",
    "cloud-run"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "morgan": "^1.10.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
